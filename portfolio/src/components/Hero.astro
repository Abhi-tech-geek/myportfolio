---
import TestRun from './TestRun.astro';
import Aurora from './Aurora.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';

// Things I test. The highlighted line of the headline cycles through these.
const targets = ['checkout flows', 'login pages', 'AI chatbots', 'APIs', 'mobile apps', 'dashboards'];
// Original one-liners (not quotes), rotated in the terminal line under the CTAs.
const truths = [
  'A test that never fails is a test nobody should trust.',
  'Every bug caught here is one your users never meet.',
  'Automate the boring checks. Think hard about the rest.',
  'Accessibility is not a feature. It is the baseline.',
  'Green builds are earned, not assumed.',
  "If it isn't tested, \"it works\" is just a rumour.",
];
---
<section class="hero">
  <div class="bg" aria-hidden="true">
    <Aurora />
    <div class="floor"><div class="floor-grid"></div></div>
  </div>

  <div class="container inner">
    <div class="copy">
      <span class="badge">
        <span class="dot pulse"></span>
        <span data-decode>Open to QA &amp; automation roles</span>
      </span>

      <h1>
        <span class="sr-only">I break software before your users do.</span>
        <span class="l1" aria-hidden="true">I break</span>
        <span class="swap" aria-hidden="true"><span class="swap-word" data-swap={JSON.stringify(targets)}>{targets[0]}</span></span>
        <span class="l3" aria-hidden="true">before your users do.</span>
      </h1>

      <p class="sub">
        I'm <strong>Abhinav</strong>, a QA engineer at Accenture. I build AI agents that test software on their own, so
        every release ships with fewer surprises.
      </p>

      <div class="cta">
        <a href="#work" class="btn btn-primary">See my work <Icon name="arrow-right" /></a>
        <a href="#about" class="btn btn-ghost">About me</a>
      </div>

      <p class="truth mono" aria-hidden="true">
        <span class="prompt">❯ qa.truth()</span>
        <span class="tq" data-truths={JSON.stringify(truths)}>{truths[0]}</span>
      </p>
    </div>

    <div class="stage">
      <p class="kicker mono"><span class="dot pulse"></span> live · one of my AI agents at work</p>
      <div class="tilt" data-tilt>
        <TestRun />
        <span class="glare" aria-hidden="true"></span>
      </div>
      <p class="caption">Every release <span class="ok">green</span>. Every failure <span class="grad-text">explained</span>.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(48px, 7vw, 96px) clamp(72px, 9vw, 120px);
  }
  .bg { position: absolute; inset: 0; pointer-events: none; }

  /* Futuristic 3D grid floor flowing toward the viewer (transform-only animation) */
  .floor {
    position: absolute;
    left: -50%;
    right: -50%;
    bottom: 0;
    height: 46%;
    perspective: 420px;
    perspective-origin: 50% 0%;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, transparent, #000 45%, #000 70%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 45%, #000 70%, transparent);
  }
  .floor-grid {
    position: absolute;
    inset: -100% 0 0;
    transform-origin: 50% 100%;
    transform: rotateX(68deg);
    background-image:
      linear-gradient(color-mix(in srgb, var(--violet) 34%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--violet) 22%, transparent) 1px, transparent 1px);
    background-size: 64px 64px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .floor-grid { animation: floor-flow 2.6s linear infinite; }
  }
  /* translate inside the rotated plane, one grid cell per loop = seamless */
  @keyframes floor-flow {
    from { transform: rotateX(68deg) translateY(0); }
    to { transform: rotateX(68deg) translateY(64px); }
  }

  .inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(40px, 5vw, 72px);
  }
  .copy { flex: 999 1 540px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .stage { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }

  .badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px;
    border: 1px solid var(--pass-border);
    border-radius: 999px;
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--pass);
    background: color-mix(in srgb, var(--pass-bg) 80%, transparent);
  }

  h1 {
    display: flex;
    flex-direction: column;
    font-size: clamp(44px, 6.4vw, 92px);
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .l3 { color: var(--text-2); font-size: 0.56em; letter-spacing: -0.035em; margin-top: 0.18em; }
  .swap {
    display: block;
    height: 1.12em;
    overflow: hidden;
    padding-bottom: 0.04em;
  }
  .swap-word {
    display: inline-block;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.05em;
    transition: translate 0.45s var(--ease-out), opacity 0.45s var(--ease-out);
  }
  .swap-word.out { translate: 0 -70%; opacity: 0; }
  .swap-word.enter { translate: 0 70%; opacity: 0; transition: none; }

  .sub { max-width: 560px; font-size: clamp(17px, 1.45vw, 20px); line-height: 1.65; color: var(--text-2); }
  .sub strong { color: var(--text); font-weight: 600; }

  .cta { display: flex; flex-wrap: wrap; gap: 14px; }

  .truth {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 12px;
    align-items: baseline;
    max-width: 600px;
    padding: 12px 16px;
    border: 1px dashed var(--border-strong);
    border-radius: 12px;
    font-size: 13.5px;
    color: var(--text-2);
    background: color-mix(in srgb, var(--surface) 55%, transparent);
  }
  .prompt { color: var(--violet); white-space: nowrap; }
  .tq { min-height: 1.5em; }

  .kicker { display: inline-flex; align-items: center; gap: 10px; font-size: 12.5px; color: var(--text-3); }
  .caption { font-size: 18px; font-weight: 600; color: var(--text-2); text-align: center; letter-spacing: -0.01em; }
  .ok { color: var(--pass); }

  /* 3D tilt (pointer-driven via --rx/--ry) with a moving glare */
  .tilt {
    position: relative;
    border-radius: 18px;
    transform: perspective(1100px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 0.6s var(--ease-out);
    will-change: transform;
  }
  .tilt.tilting { transition: transform 0.08s linear; }
  .glare {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: radial-gradient(500px circle at var(--gx, 70%) var(--gy, 0%), rgba(255, 255, 255, 0.09), transparent 45%);
    opacity: 0;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .tilt.tilting .glare { opacity: 1; }

  /* Intro choreography: opacity/translate only (no blur filters) */
  @media (prefers-reduced-motion: no-preference) {
    .badge, .l1, .swap, .l3, .sub, .cta, .truth, .stage {
      opacity: 0;
      translate: 0 18px;
      animation: rise 0.8s var(--ease-out) forwards;
    }
    .l1 { animation-delay: 0.05s; }
    .swap { animation-delay: 0.14s; }
    .l3 { animation-delay: 0.23s; }
    .sub { animation-delay: 0.36s; }
    .cta { animation-delay: 0.46s; }
    .truth { animation-delay: 0.56s; }
    .stage { animation-delay: 0.3s; }
  }
  @keyframes rise { to { opacity: 1; translate: none; } }

  @media (max-width: 760px) {
    .floor { height: 30%; }
  }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  const glyphs = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789#%&*+<>/';

  // Scramble-to-text "decode" effect
  const decode = (el: HTMLElement, text: string, frames = 22) =>
    new Promise<void>((done) => {
      let f = 0;
      const tick = () => {
        f++;
        const shown = Math.floor((f / frames) * text.length);
        el.textContent = [...text].map((c, i) => (i < shown || c === ' ' ? c : glyphs[(Math.random() * glyphs.length) | 0])).join('');
        if (f < frames) setTimeout(tick, 32);
        else { el.textContent = text; done(); }
      };
      tick();
    });

  // Pause the loops while the hero is off-screen or the tab is hidden
  const hero = document.querySelector<HTMLElement>('.hero');
  let onScreen = true;
  if (hero) new IntersectionObserver(([e]) => { onScreen = e.isIntersecting; }).observe(hero);
  const ready = async () => { while (!onScreen || document.hidden) await sleep(300); };

  if (!reduce) {
    const badge = document.querySelector<HTMLElement>('[data-decode]');
    if (badge) {
      badge.style.display = 'inline-block';
      badge.style.minWidth = `${badge.offsetWidth}px`;
      setTimeout(() => decode(badge, badge.textContent ?? ''), 250);
    }

    // Headline word swap
    const word = document.querySelector<HTMLElement>('[data-swap]');
    if (word) {
      const list: string[] = JSON.parse(word.dataset.swap ?? '[]');
      (async () => {
        let i = 0;
        await sleep(2600);
        while (true) {
          await ready();
          word.classList.add('out');
          await sleep(450);
          i = (i + 1) % list.length;
          word.textContent = list[i];
          word.classList.remove('out');
          word.classList.add('enter');
          void word.offsetWidth; // commit the start position before transitioning in
          word.classList.remove('enter');
          await sleep(2400);
        }
      })();
    }

    // Rotating QA truths
    const truth = document.querySelector<HTMLElement>('[data-truths]');
    if (truth) {
      const list: string[] = JSON.parse(truth.dataset.truths ?? '[]');
      (async () => {
        let i = 0;
        await sleep(5000);
        while (true) {
          await ready();
          i = (i + 1) % list.length;
          await decode(truth, list[i], 26);
          await sleep(5200);
        }
      })();
    }
  }

  // 3D tilt for the hero card (pointer devices only)
  const tilt = document.querySelector<HTMLElement>('[data-tilt]');
  if (tilt && !reduce && matchMedia('(hover: hover)').matches) {
    let raf = 0;
    let px = 0;
    let py = 0;
    const apply = () => {
      raf = 0;
      const b = tilt.getBoundingClientRect();
      const x = (px - b.left) / b.width;
      const y = (py - b.top) / b.height;
      tilt.style.setProperty('--ry', `${(x - 0.5) * 12}deg`);
      tilt.style.setProperty('--rx', `${(0.5 - y) * 10}deg`);
      tilt.style.setProperty('--gx', `${x * 100}%`);
      tilt.style.setProperty('--gy', `${y * 100}%`);
    };
    tilt.addEventListener('pointerenter', () => tilt.classList.add('tilting'));
    tilt.addEventListener('pointermove', (e) => {
      px = e.clientX;
      py = e.clientY;
      if (!raf) raf = requestAnimationFrame(apply);
    });
    tilt.addEventListener('pointerleave', () => {
      tilt.classList.remove('tilting');
      tilt.style.setProperty('--rx', '0deg');
      tilt.style.setProperty('--ry', '0deg');
    });
  }
</script>
