---
import Editorial from '../../layouts/Editorial.astro';
import ProjectLogo from '../../components/ProjectLogo.astro';
import { projects, getProject, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
interface Props { project: Project }
const { project: p } = Astro.props;
const next = getProject(p.next);
const status =
  p.status === 'paused' ? 'Hosted demo offline. The code is on GitHub.'
  : p.status === 'soon' ? 'Being rebuilt as version 2.'
  : p.status === 'android' ? 'Android app, available as an APK.'
  : 'Live.';
---
<Editorial title={`${p.seo.title} | Abhinav Saxena`} description={p.seo.description} og={p.seo.og} path={`/${p.slug}`}>
  <article>
    <header class="wrap head">
      <a class="back" href="/#work">All projects</a>
      <div class="title">
        <span class="logo" aria-hidden="true"><ProjectLogo slug={p.slug} size={34} /></span>
        <h1>{p.name}</h1>
      </div>
      <p class="tagline">{p.tagline}</p>
      <dl class="meta-grid">
        <div><dt>Type</dt><dd>{p.category}</dd></div>
        <div><dt>Status</dt><dd>{status}</dd></div>
        <div><dt>My role</dt><dd>{p.role}</dd></div>
      </dl>
      <p class="links">
        <a class="btn" href={p.primary.href} target="_blank" rel="noopener">{p.primary.label}</a>
        {p.secondary && <a class="textlink" href={p.secondary.href} target="_blank" rel="noopener">{p.secondary.label}</a>}
      </p>
    </header>

    <section class="wrap sec" aria-labelledby="problem-h">
      <div class="sec-label"><span class="num">01</span><h2 id="problem-h">The problem</h2></div>
      <div>
        <p class="lead">{p.problem}</p>
        {p.overview.map((para) => <p class="body" style="margin-top:1.1em">{para}</p>)}
      </div>
    </section>

    <section class="wrap sec" aria-labelledby="decisions-h">
      <div class="sec-label"><span class="num">02</span><h2 id="decisions-h">Decisions that mattered</h2></div>
      <ol class="decisions">
        {p.decisions.map((d, i) => (
          <li><span class="n">{String(i + 1).padStart(2, '0')}</span><p class="body">{d}</p></li>
        ))}
      </ol>
    </section>

    <section class="wrap sec" aria-labelledby="features-h">
      <div class="sec-label">
        <span class="num">03</span><h2 id="features-h">{p.featuresTitle}</h2>
        {p.featuresLead && <p class="meta">{p.featuresLead}</p>}
      </div>
      <dl class="features">
        {p.features.map((f) => (
          <div><dt>{f.title}</dt><dd>{f.desc}</dd></div>
        ))}
      </dl>
    </section>

    <section class="wrap sec" aria-labelledby="stack-h">
      <div class="sec-label"><span class="num">04</span><h2 id="stack-h">Built with</h2></div>
      <div>
        <p class="lead">{p.stack.join(', ')}.</p>
        {p.metrics.length > 0 && (
          <dl class="numbers">
            {p.metrics.map((m) => <div><dt>{m.label}</dt><dd>{m.value}</dd></div>)}
          </dl>
        )}
      </div>
    </section>

    {p.runLocally && (
      <section class="wrap sec" aria-labelledby="run-h">
        <div class="sec-label"><span class="num">05</span><h2 id="run-h">Run it yourself</h2></div>
        <div>
          <p class="body">
            The hosted demo is offline for now, but the code is open. Run it locally and Chrome opens and performs every
            click, type and navigation in front of you.
          </p>
          <pre class="code"><code>{p.runLocally.map((l) => (l.comment
            ? <span class="c">{l.comment}{'\n'}</span>
            : <span><span class="pr" aria-hidden="true">$ </span>{l.cmd}{'\n'}</span>))}</code></pre>
        </div>
      </section>
    )}

    <nav class="wrap nextp" aria-label="Next project">
      <span class="meta">Next project</span>
      <a href={`/${next.slug}`}>{next.name}</a>
      <span class="body">{next.tagline}</span>
    </nav>
  </article>
</Editorial>

<style>
  .head { display: flex; flex-direction: column; gap: 22px; padding-block: clamp(24px, 5vw, 56px) clamp(48px, 7vw, 88px); }
  .back { align-self: flex-start; font-size: 16px; color: var(--ink-2); padding-block: 8px; }
  .title { display: flex; align-items: center; gap: 18px; }
  .logo { display: grid; place-items: center; width: 60px; height: 60px; flex: none; border: 1px solid var(--rule); border-radius: 10px; }
  h1 { font-size: clamp(48px, 8vw, 104px); letter-spacing: -0.03em; line-height: 1; }
  .tagline { font-family: var(--f-serif); font-style: italic; font-size: clamp(24px, 2.8vw, 34px); color: var(--ink-2); max-width: 30ch; }
  .meta-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    margin: 8px 0 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  @media (min-width: 760px) { .meta-grid { grid-template-columns: 1fr 1.4fr 2fr; } }
  .meta-grid div { padding: 16px 0; }
  @media (min-width: 760px) { .meta-grid div + div { padding-left: 24px; border-left: 1px solid var(--rule); } }
  .meta-grid dt, .features dt, .numbers dt { font-family: var(--f-mono); font-size: 13px; color: var(--ink-3); margin-bottom: 4px; }
  .meta-grid dd { margin: 0; color: var(--ink); }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 26px; }

  .decisions { display: flex; flex-direction: column; }
  .decisions li { display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 12px; padding-block: 18px; border-bottom: 1px solid var(--rule); }
  .decisions li:first-child { padding-top: 0; }
  .decisions .n { font-family: var(--f-mono); font-size: 14px; color: var(--accent); padding-top: 4px; }
  .decisions strong { color: var(--ink); }

  .features { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0 40px; margin: 0; }
  @media (min-width: 700px) { .features { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .features div { padding-block: 16px; border-bottom: 1px solid var(--rule); }
  .features dt { font-family: var(--f-sans); font-size: 18px; font-weight: 700; color: var(--ink); }
  .features dd { margin: 0; color: var(--ink-2); }

  .numbers { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 24px; margin: 32px 0 0; }
  .numbers dd { margin: 0; font-family: var(--f-serif); font-size: 40px; line-height: 1; }

  .code {
    margin: 22px 0 0;
    padding: 20px 22px;
    overflow-x: auto;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--paper-2);
    font-family: var(--f-mono);
    font-size: 14px;
    line-height: 1.8;
  }
  .code .c { color: var(--ink-3); }
  .code .pr { color: var(--accent); }

  .nextp { display: flex; flex-direction: column; gap: 6px; padding-block: 48px 72px; border-top: 1px solid var(--rule); }
  .nextp a { font-family: var(--f-serif); font-size: clamp(36px, 5vw, 60px); line-height: 1.1; width: fit-content; }
</style>
