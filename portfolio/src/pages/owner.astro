---
// Direct owner sign-in page (same dialog as the footer lock button, opened straight away).
// Not linked anywhere and excluded from search engines.
import OwnerDialog from '../components/OwnerDialog.astro';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Owner</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main>
      <p>Owner sign-in</p>
      <OwnerDialog />
      <a href="/">Back to the site</a>
    </main>
    <style>
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: #0e0e0e;
        color: #ddd;
        font: 16px/1.5 system-ui, sans-serif;
      }
      main { display: flex; flex-direction: column; align-items: center; gap: 12px; }
      a { color: #bbb; }
    </style>
    <script>
      addEventListener('load', () => dispatchEvent(new CustomEvent('owner:open', { detail: 'login' })));
    </script>
  </body>
</html>
