---
// A real Gherkin scenario (the format I write every day) that "runs" itself: each step types
// in and turns green, then the summary appears. Visitors can replay it. The markup is the
// finished state, so no-JS and reduced-motion visitors see the complete, passed scenario.
const steps = [
  { kw: 'Given', text: 'a product with real users' },
  { kw: 'When', text: 'Abhinav tests it' },
  { kw: 'Then', text: 'bugs are found before your users find them' },
  { kw: 'And', text: 'every failure comes with a clear reason' },
];
---
<figure class="feat" data-feature aria-label="A Gherkin test scenario titled Hiring a QA engineer, with all four steps passing">
  <div class="bar">
    <span class="file"><span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>hire.feature</span>
    <button type="button" class="run" data-run-again>
      <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M7 5v14l11-7z" fill="currentColor" /></svg>
      Run again
    </button>
  </div>

  <div class="code">
    <p class="line"><span class="kw">Feature:</span> Hiring a QA engineer</p>
    <p class="line ind1"><span class="kw">Scenario:</span> You need releases you can trust</p>
    {steps.map((s) => (
      <p class="line ind2 step" data-step data-state="pass">
        <span class="mark" aria-hidden="true">
          <svg class="ok" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          <span class="spin"></span>
        </span>
        <span class="kw">{s.kw}</span> <span class="txt" data-text={s.text}>{s.text}</span>
      </p>
    ))}
  </div>

  <div class="sum" data-sum data-state="pass">
    <span data-sum-text>1 scenario (1 passed) · 4 steps (4 passed)</span>
    <span class="t" data-sum-time>0.8s</span>
  </div>
</figure>

<style>
  .feat {
    margin: 0;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
    font-family: var(--f-mono);
    box-shadow: var(--shadow-card);
  }
  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 10px 12px 10px 16px;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
    font-size: 13px;
    color: var(--text-3);
  }
  .file { display: inline-flex; align-items: center; gap: 12px; }
  .dots { display: inline-flex; gap: 6px; }
  .dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--border-strong); }
  .run {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: transparent;
    color: var(--text-2);
    font: 500 12.5px/1 var(--f-mono);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s;
  }
  .run:hover { color: var(--text); border-color: var(--violet); }
  .run:disabled { opacity: 0.5; cursor: default; }

  .code { display: flex; flex-direction: column; gap: 10px; padding: 22px 20px 20px; font-size: 14.5px; line-height: 1.5; }
  .line { margin: 0; color: var(--text); }
  .ind1 { padding-left: 18px; }
  .ind2 { padding-left: 18px; display: grid; grid-template-columns: 22px auto minmax(0, 1fr); column-gap: 8px; align-items: baseline; }
  .kw { color: var(--violet); }
  .step .txt { color: var(--text-2); }

  .mark { display: grid; place-items: center; width: 18px; height: 18px; align-self: center; }
  .mark > * { grid-area: 1 / 1; display: none; }
  .ok { color: var(--pass); }
  .spin {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--border-strong);
    border-top-color: var(--violet);
    animation: spin 0.7s linear infinite;
  }
  .step[data-state='pass'] .ok { display: block; animation: pop 0.35s var(--ease-spring); }
  .step[data-state='run'] .spin { display: block; }
  .step[data-state='idle'] { opacity: 0.35; }
  .step[data-state='pass'] .txt { color: var(--text); }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes pop { from { transform: scale(0.3); } to { transform: none; } }

  .sum {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 20px;
    border-top: 1px solid var(--border);
    font-size: 13px;
    transition: background-color 0.4s, color 0.4s;
  }
  .sum[data-state='pass'] { background: var(--pass-bg); color: var(--pass); }
  .sum[data-state='run'] { color: var(--text-3); }
  .t { color: var(--text-3); }

  .txt :global(.caret) {
    display: inline-block;
    width: 7px;
    height: 1em;
    margin-left: 1px;
    vertical-align: -2px;
    background: var(--violet);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-feature]');
  if (root) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const sum = root.querySelector<HTMLElement>('[data-sum]')!;
    const sumText = root.querySelector<HTMLElement>('[data-sum-text]')!;
    const sumTime = root.querySelector<HTMLElement>('[data-sum-time]')!;
    const btn = root.querySelector<HTMLButtonElement>('[data-run-again]')!;
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let running = false;

    const run = async () => {
      if (running) return;
      running = true;
      btn.disabled = true;
      steps.forEach((s) => (s.dataset.state = 'idle'));
      sum.dataset.state = 'run';
      sumText.textContent = 'running hire.feature…';
      sumTime.textContent = '';
      const t0 = performance.now();

      for (const s of steps) {
        const txt = s.querySelector<HTMLElement>('[data-text]')!;
        const full = txt.dataset.text ?? '';
        s.dataset.state = 'run';
        txt.textContent = '';
        const caret = document.createElement('span');
        caret.className = 'caret';
        for (const ch of full) { txt.textContent += ch; txt.append(caret); await sleep(ch === ' ' ? 10 : 22); }
        caret.remove();
        await sleep(280);
        s.dataset.state = 'pass';
        await sleep(160);
      }

      sum.dataset.state = 'pass';
      sumText.textContent = '1 scenario (1 passed) · 4 steps (4 passed)';
      sumTime.textContent = `${((performance.now() - t0) / 1000).toFixed(1)}s`;
      btn.disabled = false;
      running = false;
    };

    btn.addEventListener('click', run);

    // Play once, the first time the card comes into view
    if (!reduce) {
      const io = new IntersectionObserver(([e]) => {
        if (e.isIntersecting) { io.disconnect(); setTimeout(run, 700); }
      }, { threshold: 0.5 });
      io.observe(root);
    }
  }
</script>
