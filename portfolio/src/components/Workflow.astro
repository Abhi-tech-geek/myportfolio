---
import { workflow } from '../data/site';
const last = workflow.length - 1;
---
<section id="approach" class="section">
  <div class="container wrap">
    <div class="intro">
      <span class="eyebrow">// how I test</span>
      <h2>From a requirement to a release that's <span class="ok">safe to ship.</span></h2>
      <p>Six stages I run on every feature. Scroll — the release turns green only once every stage has passed.</p>
      <div class="state" data-wf-state aria-live="polite">
        <span class="sd"></span><span data-wf-label>In progress</span>
      </div>
    </div>

    <div class="steps" data-wf>
      <span class="line" aria-hidden="true"><span class="fill"></span></span>
      <ol class="list">
      {workflow.map((s, i) => (
        <li class:list={['step', { final: i === last }]} data-step>
          <span class="node" aria-hidden="true">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <svg class="tick" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          </span>
          <div class="body">
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
            <div class="foot">
              <ul class="tools" aria-label="Tools">
                {s.tools.map((t) => <li>{t}</li>)}
              </ul>
              <span class="deliv">→ {s.deliverable}</span>
            </div>
          </div>
        </li>
      ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .wrap { display: flex; flex-wrap: wrap; gap: clamp(40px, 6vw, 96px); }
  .intro {
    flex: 1 1 340px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    align-self: flex-start;
  }
  @media (min-width: 980px) { .intro { position: sticky; top: 120px; } }
  .intro h2 { font-size: clamp(36px, 4.2vw, 54px); }
  .intro p { color: var(--text-2); max-width: 440px; }
  .ok { color: var(--pass); }

  .state {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 8px;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--text-2);
    transition: all 0.5s var(--ease-out);
  }
  .sd { width: 8px; height: 8px; border-radius: 50%; background: var(--warn); }
  .state.done { color: var(--pass); border-color: var(--pass-border); background: var(--pass-bg); }
  .state.done .sd { background: var(--pass); animation: dot-pulse 2.4s infinite; }

  .steps {
    --wf: 0;
    flex: 999 1 520px;
    min-width: 0;
    position: relative;
  }
  .list { display: flex; flex-direction: column; gap: 18px; }
  .line {
    position: absolute;
    left: 21px;
    top: 24px;
    bottom: 24px;
    width: 2px;
    background: var(--border);
    border-radius: 2px;
  }
  .fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, #8b5cf6, #3b82f6 55%, var(--pass));
    transform-origin: top;
    transform: scaleY(var(--wf));
    box-shadow: 0 0 12px rgba(139, 92, 246, 0.5);
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 20px;
  }
  .node {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--border-strong);
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--text-3);
    transition: border-color 0.4s, color 0.4s, background-color 0.4s, box-shadow 0.4s, transform 0.5s var(--ease-spring);
  }
  .node > * { grid-area: 1 / 1; transition: opacity 0.3s, transform 0.4s var(--ease-spring); }
  .tick { opacity: 0; transform: scale(0.4); }

  .body {
    padding: 22px 24px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    transition: border-color 0.4s, background-color 0.4s, opacity 0.4s;
    opacity: 0.55;
  }
  .body h3 { font-size: 21px; font-weight: 600; letter-spacing: -0.01em; }
  .body p { margin-top: 8px; font-size: 15.5px; color: var(--text-2); }
  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px 16px; margin-top: 16px; }
  .tools { display: flex; flex-wrap: wrap; gap: 6px; }
  .tools li {
    padding: 4px 10px;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-family: var(--f-mono);
    font-size: 12px;
    color: var(--text-3);
  }
  .deliv { font-family: var(--f-mono); font-size: 12.5px; color: var(--violet); }

  /* Reached */
  .step.on .node { border-color: var(--violet); color: var(--text); box-shadow: 0 0 0 6px color-mix(in srgb, var(--violet) 14%, transparent); }
  .step.on .body { opacity: 1; border-color: var(--border-strong); }
  .step.passed .num { opacity: 0; transform: scale(0.4); }
  .step.passed .tick { opacity: 1; transform: none; color: var(--violet); }

  /* Final stage turns the whole release green */
  .step.final.passed .node { border-color: var(--pass); background: var(--pass-bg); box-shadow: 0 0 0 8px color-mix(in srgb, var(--pass) 16%, transparent); transform: scale(1.08); }
  .step.final.passed .tick { color: var(--pass); }
  .step.final.passed .body { border-color: var(--pass-border); background: var(--pass-bg); }
  .step.final.passed .deliv { color: var(--pass); }

  @media (max-width: 560px) {
    .step { grid-template-columns: 36px minmax(0, 1fr); gap: 14px; }
    .node { width: 36px; height: 36px; font-size: 12px; }
    .line { left: 17px; }
    .body { padding: 18px; }
  }
</style>

<script>
  const list = document.querySelector<HTMLElement>('[data-wf]');
  if (list) {
    const steps = [...list.querySelectorAll<HTMLElement>('[data-step]')];
    const state = document.querySelector<HTMLElement>('[data-wf-state]')!;
    const label = document.querySelector<HTMLElement>('[data-wf-label]')!;
    let active = false;
    let ticking = false;

    const update = () => {
      ticking = false;
      // Read every rect first, then write — mixing them forces a layout per step.
      const r = list.getBoundingClientRect();
      const tops = steps.map((s) => s.getBoundingClientRect().top);
      const anchor = innerHeight * 0.62;
      const p = Math.min(1, Math.max(0, (anchor - r.top) / r.height));
      list.style.setProperty('--wf', p.toFixed(4));
      let passed = 0;
      steps.forEach((s, i) => {
        const done = tops[i] + 22 < anchor;
        s.classList.toggle('on', tops[i] < innerHeight * 0.8);
        s.classList.toggle('passed', done);
        if (done) passed++;
      });
      const all = passed === steps.length;
      state.classList.toggle('done', all);
      label.textContent = all ? 'Release signed off · all green' : `In progress · ${passed}/${steps.length} stages`;
    };
    const onScroll = () => { if (active && !ticking) { ticking = true; requestAnimationFrame(update); } };

    new IntersectionObserver(([e]) => { active = e.isIntersecting; if (active) update(); }, { rootMargin: '20% 0px' }).observe(list);
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    update();
  }
</script>
