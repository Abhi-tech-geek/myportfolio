---
import { toolbelt } from '../data/site';
---
<section class="marquee" aria-label="Tools I work with">
  <ul class="track">
    {toolbelt.map((t) => <li>{t}</li>)}
    {toolbelt.map((t) => <li aria-hidden="true">{t}</li>)}
  </ul>
</section>

<style>
  .marquee {
    position: relative;
    border-block: 1px solid var(--border);
    overflow: hidden;
    padding-block: 18px;
  }
  /* Edge fades as plain overlays (not mask-image), so the moving strip stays a cheap transform */
  .marquee::before,
  .marquee::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 12%;
    z-index: 1;
    pointer-events: none;
  }
  .marquee::before { left: 0; background: linear-gradient(90deg, var(--bg), transparent); }
  .marquee::after { right: 0; background: linear-gradient(-90deg, var(--bg), transparent); }
  .track {
    display: flex;
    width: max-content;
    animation: slide 46s linear infinite;
  }
  .marquee:hover .track { animation-play-state: paused; }
  li {
    display: flex;
    align-items: center;
    gap: 40px;
    padding-right: 40px;
    font-family: var(--f-mono);
    font-size: 15px;
    color: var(--text-3);
    white-space: nowrap;
  }
  li::after {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--violet);
  }
  @keyframes slide { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .track { flex-wrap: wrap; width: auto; justify-content: center; animation: none; padding-inline: 20px; }
    li[aria-hidden='true'] { display: none; }
  }
</style>
