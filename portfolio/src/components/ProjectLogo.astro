---
import type { Project } from '../data/projects';
interface Props { slug: Project['slug']; size?: number }
const { slug, size = 28 } = Astro.props;
---
{slug === 'abhimate' && (
  <svg viewBox="0 0 64 64" width={size} height={size} aria-hidden="true">
    <path d="M32 6 L58 19 L32 32 L6 19 Z" fill="currentColor" />
    <path d="M6 29 L32 42 L58 29" stroke="currentColor" stroke-width="5" fill="none" stroke-linejoin="round" stroke-linecap="round" opacity="0.6" />
    <path d="M6 40 L32 53 L58 40" stroke="currentColor" stroke-width="5" fill="none" stroke-linejoin="round" stroke-linecap="round" opacity="0.35" />
  </svg>
)}
{slug === 'aurago' && (
  <svg viewBox="0 0 64 64" width={size} height={size} aria-hidden="true">
    <path d="M34 4 C36 22 42 28 60 30 C42 32 36 38 34 56 C32 38 26 32 8 30 C26 28 32 22 34 4 Z" fill="currentColor" />
    <path d="M52 5 C53 11 55 13 61 14 C55 15 53 17 52 23 C51 17 49 15 43 14 C49 13 51 11 52 5 Z" fill="currentColor" opacity="0.8" />
  </svg>
)}
{slug === 'discova' && (
  <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="10" />
    <circle cx="12" cy="7" r="1.4" fill="currentColor" />
    <path d="M7 10 L12 11 L17 10" />
    <path d="M12 11 V14 L9 18" />
    <path d="M12 14 L15 18" />
  </svg>
)}
{slug === 'abhinova' && (
  <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M12 2 V7" /><path d="M12 17 V22" /><path d="M2 12 H7" /><path d="M17 12 H22" />
    <path d="M5 5 L8.5 8.5" /><path d="M15.5 15.5 L19 19" /><path d="M19 5 L15.5 8.5" /><path d="M8.5 15.5 L5 19" />
    <circle cx="12" cy="12" r="2.5" fill="currentColor" />
  </svg>
)}
