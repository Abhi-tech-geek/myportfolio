---
import Icon from './Icon.astro';
import OwnerDialog from './OwnerDialog.astro';
import { site } from '../data/site';
---
<footer class="footer">
  <div class="container inner">
    <span>© {new Date().getFullYear()} {site.name} · theabhinavsaxena.in</span>
    <span class="social">
      <a href={site.github} target="_blank" rel="noopener"><Icon name="github" size={16} /> github</a>
      <a href={site.linkedin} target="_blank" rel="noopener"><Icon name="linkedin" size={16} /> linkedin</a>
      <a href="#top" class="top" aria-label="Back to top"><Icon name="arrow-up" size={16} /></a>
      <OwnerDialog variant="neon" />
    </span>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding-block: 32px 40px;
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--text-3);
  }
  .social { display: flex; align-items: center; gap: 22px; }
  a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    text-decoration: none;
    color: var(--text-2);
    transition: color 0.2s;
  }
  a:hover { color: var(--text); }
  .top {
    justify-content: center;
    width: 44px;
    border: 1px solid var(--border-strong);
    border-radius: 10px;
  }
</style>
