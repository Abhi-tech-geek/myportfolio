---
import HireFeature from './HireFeature.astro';
import Aurora from './Aurora.astro';
import Icon from './Icon.astro';

// The one word that changes in the sub-headline.
const targets = ['web apps', 'APIs', 'mobile apps', 'AI chatbots', 'checkout flows'];
// Original one-liners (not quotes), typed out in the terminal line under the CTAs.
const truths = [
  'A test that never fails is a test nobody should trust.',
  'Every bug caught here is one your users never meet.',
  'Automate the boring checks. Think hard about the rest.',
  'Accessibility is not a feature. It is the baseline.',
  'Green builds are earned, not assumed.',
];
---
<section class="hero">
  <div class="bg" aria-hidden="true">
    <Aurora />
    <div class="floor"><div class="floor-grid"></div></div>
  </div>

  <div class="container inner">
    <div class="copy">
      <span class="badge"><span class="dot pulse"></span> Open to QA &amp; automation roles</span>

      <h1>
        <span class="l1">I find the bugs</span>
        <span class="l2">before your users do.</span>
      </h1>

      <p class="dyn">
        <span class="sr-only">Testing web apps, APIs, mobile apps, AI chatbots and checkout flows with AI agents that work on their own.</span>
        <span aria-hidden="true">Testing <span class="word" data-swap={JSON.stringify(targets)}>{targets[0]}</span> with AI agents that work on their own.</span>
      </p>

      <p class="sub">
        I'm <strong>Abhinav Saxena</strong>, a QA engineer at Accenture. I build AI tools that make testing faster and
        software easier for everyone to use.
      </p>

      <div class="cta">
        <a href="#work" class="btn btn-primary">See my work <Icon name="arrow-right" /></a>
        <a href="#about" class="btn btn-ghost">About me</a>
      </div>

      <p class="truth mono" aria-hidden="true">
        <span class="prompt">❯ qa.truth()</span>
        <span class="tq" data-truths={JSON.stringify(truths)}>{truths[0]}</span><span class="tcaret"></span>
      </p>
    </div>

    <div class="stage">
      <HireFeature />
      <p class="caption">Every release <span class="ok">green</span>. Every failure <span class="grad-text">explained</span>.</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(48px, 7vw, 100px) clamp(72px, 9vw, 120px);
  }
  .bg { position: absolute; inset: 0; pointer-events: none; }
  /* 3D grid floor flowing toward the viewer. The grid texture is painted once; the loop only
     moves it inside the tilted plane (transform), and pauses when the hero is off-screen. */
  .floor {
    position: absolute;
    left: -30%;
    right: -30%;
    bottom: 0;
    height: 42%;
    perspective: 420px;
    perspective-origin: 50% 0%;
    overflow: hidden;
    mask-image: linear-gradient(to bottom, transparent, #000 45%, #000 72%, transparent);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 45%, #000 72%, transparent);
  }
  .floor-grid {
    position: absolute;
    inset: -60% 0 0;
    transform-origin: 50% 100%;
    transform: rotateX(68deg);
    background-image:
      linear-gradient(color-mix(in srgb, var(--violet) 34%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--violet) 22%, transparent) 1px, transparent 1px);
    background-size: 64px 64px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .floor-grid { animation: floor-flow 2.8s linear infinite; }
    .hero.idle .floor-grid { animation-play-state: paused; }
  }
  @keyframes floor-flow {
    from { transform: rotateX(68deg) translateY(0); }
    to { transform: rotateX(68deg) translateY(64px); }
  }
  @media (max-width: 760px) { .floor { height: 28%; } }

  .inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(40px, 5vw, 72px);
  }
  .copy { flex: 999 1 540px; min-width: 0; display: flex; flex-direction: column; gap: 22px; }
  .stage { flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .caption { margin: 0; font-size: 18px; font-weight: 600; letter-spacing: -0.01em; color: var(--text-2); text-align: center; }
  .ok { color: var(--pass); }

  .badge {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px;
    border: 1px solid var(--pass-border);
    border-radius: 999px;
    font-family: var(--f-mono);
    font-size: 13px;
    color: var(--pass);
    background: color-mix(in srgb, var(--pass-bg) 80%, transparent);
  }

  h1 {
    display: flex;
    flex-direction: column;
    font-size: clamp(42px, 6vw, 86px);
    line-height: 1.02;
    letter-spacing: -0.045em;
  }
  .l2 {
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-bottom: 0.06em;
  }

  .dyn {
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.35;
    color: var(--text-2);
  }
  .word {
    display: inline-block;
    color: var(--text);
    border-bottom: 2px solid var(--violet);
    transition: opacity 0.3s ease, translate 0.3s var(--ease-out);
  }
  .word.out { opacity: 0; translate: 0 -0.3em; }
  .word.enter { opacity: 0; translate: 0 0.3em; transition: none; }

  .sub { max-width: 580px; font-size: clamp(16.5px, 1.35vw, 18.5px); line-height: 1.65; color: var(--text-2); }
  .sub strong { color: var(--text); font-weight: 600; }

  .cta { display: flex; flex-wrap: wrap; gap: 14px; }

  .truth {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    max-width: 600px;
    padding: 12px 16px;
    border: 1px dashed var(--border-strong);
    border-radius: 12px;
    font-size: 13.5px;
    color: var(--text-2);
    background: color-mix(in srgb, var(--surface) 55%, transparent);
  }
  .prompt { color: var(--violet); white-space: nowrap; }
  .tq { min-height: 1.5em; }
  .tcaret {
    display: inline-block;
    width: 7px;
    height: 1em;
    margin-left: -8px;
    align-self: center;
    background: var(--violet);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  /* Intro choreography: opacity/translate only */
  @media (prefers-reduced-motion: no-preference) {
    .badge, .l1, .l2, .dyn, .sub, .cta, .truth, .stage {
      opacity: 0;
      translate: 0 18px;
      animation: rise 0.8s var(--ease-out) forwards;
    }
    .l1 { animation-delay: 0.05s; }
    .l2 { animation-delay: 0.14s; }
    .dyn { animation-delay: 0.26s; }
    .sub { animation-delay: 0.36s; }
    .cta { animation-delay: 0.46s; }
    .truth { animation-delay: 0.56s; }
    .stage { animation-delay: 0.3s; }
  }
  @keyframes rise { to { opacity: 1; translate: none; } }
</style>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  // Pause loops while the hero is off-screen or the tab is hidden
  const hero = document.querySelector<HTMLElement>('.hero');
  let onScreen = true;
  if (hero) new IntersectionObserver(([e]) => {
    onScreen = e.isIntersecting;
    hero.classList.toggle('idle', !onScreen); // pauses the floor + aurora CSS loops off-screen
  }).observe(hero);
  const ready = async () => { while (!onScreen || document.hidden) await sleep(300); };

  if (!reduce) {
    // Sub-headline word swap
    const word = document.querySelector<HTMLElement>('[data-swap]');
    if (word) {
      const list: string[] = JSON.parse(word.dataset.swap ?? '[]');
      (async () => {
        let i = 0;
        await sleep(2800);
        while (true) {
          await ready();
          word.classList.add('out');
          await sleep(300);
          i = (i + 1) % list.length;
          word.textContent = list[i];
          word.classList.remove('out');
          word.classList.add('enter');
          void word.offsetWidth; // commit the start position before easing in
          word.classList.remove('enter');
          await sleep(2600);
        }
      })();
    }

    // QA truths: erase, then type the next one
    const truth = document.querySelector<HTMLElement>('[data-truths]');
    if (truth) {
      const list: string[] = JSON.parse(truth.dataset.truths ?? '[]');
      (async () => {
        let i = 0;
        await sleep(5000);
        while (true) {
          await ready();
          const cur = truth.textContent ?? '';
          for (let n = cur.length; n >= 0; n -= 2) { truth.textContent = cur.slice(0, n); await sleep(12); }
          i = (i + 1) % list.length;
          const next = list[i];
          for (let n = 1; n <= next.length; n++) { truth.textContent = next.slice(0, n); await sleep(30); }
          await sleep(5000);
        }
      })();
    }
  }
</script>
