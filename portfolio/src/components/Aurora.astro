---
// Aurora behind the hero — "render once, animate cheaply".
// The WebGL shader runs only TWICE (two moments of the same flow), once the page is idle.
// Each frame is copied into a plain canvas and the GPU context is released.
// The motion you see is CSS only: the two frames cross-fade and the layer drifts, which the
// compositor does for free. So the look of a live shader, at the cost of two static images.
---
<div class="aurora" aria-hidden="true">
  <div class="fallback"></div>
  <div class="layer" data-aurora>
    <canvas class="a"></canvas>
    <canvas class="b"></canvas>
  </div>
</div>

<style>
  .aurora { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .fallback {
    position: absolute;
    top: -25%;
    right: -12%;
    width: 65%;
    height: 130%;
    background: radial-gradient(closest-side, rgba(139, 92, 246, 0.28), rgba(236, 72, 153, 0.08) 55%, transparent);
  }
  .layer {
    position: absolute;
    inset: -6%;
    opacity: 0;
    transition: opacity 1.4s ease;
  }
  .layer.on { opacity: 1; }
  :global(:root[data-theme='light']) .layer.on { opacity: 0.5; }
  canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  canvas.b { opacity: 0; }

  @media (prefers-reduced-motion: no-preference) {
    .layer.on { animation: drift 26s ease-in-out infinite alternate; }
    .layer.on canvas.b { animation: morph 11s ease-in-out infinite alternate; }
  }
  /* paused while the hero is off-screen (class set by Hero) */
  :global(.hero.idle) .layer, :global(.hero.idle) canvas { animation-play-state: paused !important; }

  @keyframes drift {
    from { transform: translate3d(0, 0, 0) scale(1); }
    to { transform: translate3d(-3%, 2.5%, 0) scale(1.07); }
  }
  @keyframes morph { from { opacity: 0; } to { opacity: 1; } }
</style>

<script>
  const layer = document.querySelector<HTMLElement>('[data-aurora]');
  const saveData = (navigator as any).connection?.saveData === true;

  const render = () => {
    if (!layer || saveData) return;
    const targets = [...layer.querySelectorAll('canvas')];
    const box = layer.getBoundingClientRect();
    const SCALE = 0.5;
    const w = Math.max(1, Math.round(box.width * SCALE));
    const h = Math.max(1, Math.round(box.height * SCALE));

    const glc = document.createElement('canvas');
    glc.width = w;
    glc.height = h;
    const gl = glc.getContext('webgl', { alpha: true, antialias: false, premultipliedAlpha: true, preserveDrawingBuffer: true });
    if (!gl) return;

    const vs = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
    const fs = `
      precision mediump float;
      uniform vec2 r; uniform float t;
      float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
      float n(vec2 p){vec2 i=floor(p),f=fract(p);vec2 u=f*f*(3.-2.*f);
        return mix(mix(h(i),h(i+vec2(1,0)),u.x),mix(h(i+vec2(0,1)),h(i+vec2(1,1)),u.x),u.y);}
      float fbm(vec2 p){float v=0.,a=.5;for(int i=0;i<5;i++){v+=a*n(p);p=p*2.03+vec2(1.7,9.2);a*=.5;}return v;}
      void main(){
        vec2 uv=gl_FragCoord.xy/r;
        vec2 p=uv*vec2(r.x/r.y,1.)*1.7;
        float tt=t*.035;
        vec2 q=vec2(fbm(p+vec2(0.,tt)),fbm(p+vec2(5.2,1.3)-tt));
        vec2 w=vec2(fbm(p+2.2*q+vec2(1.7,9.2)+tt*1.4),fbm(p+2.2*q+vec2(8.3,2.8)-tt));
        float f=fbm(p+2.6*w);
        vec3 violet=vec3(.545,.361,.965), blue=vec3(.231,.510,.965), pink=vec3(.925,.282,.6);
        vec3 col=mix(violet,blue,clamp(q.x*1.5-.2,0.,1.));
        col=mix(col,pink,clamp(w.y*w.y*1.8-.15,0.,1.));
        float a=smoothstep(.42,1.,f)*.66;
        a*=smoothstep(.05,.75,uv.x*.9+uv.y*.35);   /* keep the copy side calm */
        gl_FragColor=vec4(col*a,a);
      }`;
    const sh = (type: number, src: string) => { const s = gl.createShader(type)!; gl.shaderSource(s, src); gl.compileShader(s); return s; };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, vs));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    gl.viewport(0, 0, w, h);
    gl.uniform2f(gl.getUniformLocation(prog, 'r'), w, h);
    const uT = gl.getUniformLocation(prog, 't');

    // Two moments of the same flow; CSS blends between them.
    [0, 55].forEach((time, i) => {
      gl.uniform1f(uT, time);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
      const c = targets[i];
      c.width = w;
      c.height = h;
      c.getContext('2d')!.drawImage(glc, 0, 0);
    });
    gl.getExtension('WEBGL_lose_context')?.loseContext(); // free the GPU context right away
    layer.classList.add('on');
  };

  const later = () =>
    'requestIdleCallback' in window ? requestIdleCallback(render, { timeout: 1500 }) : setTimeout(render, 400);
  if (document.readyState === 'complete') later();
  else addEventListener('load', later, { once: true });
</script>
