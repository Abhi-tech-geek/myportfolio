---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import Icon from './Icon.astro';
import { stats, journey, site } from '../data/site';

const roles = ['a QA Engineer', 'an Automation Specialist', 'an AI Builder', 'an Accessibility Advocate'];
---
<section id="about" class="section">
  <div class="container">
    <div class="top">
      <figure class="photo reveal">
        <Image src={avatar} alt="Abhinav Saxena at his desk with code on the screens behind him" widths={[360, 560, 720]} sizes="(max-width: 760px) 90vw, 420px" loading="lazy" />
        <figcaption class="mono"><span class="dot pulse"></span> Gurgaon, India</figcaption>
      </figure>

      <div class="text">
        <span class="eyebrow reveal">// about me</span>
        <h2 class="reveal">Hi, I'm <span class="grad-text">Abhinav Saxena</span></h2>

        <p class="role reveal">
          <span class="sr-only">I'm {roles.slice(0, -1).join(', ')} and {roles.at(-1)}.</span>
          <span aria-hidden="true" class="role-pre">I'm</span>
          <span aria-hidden="true" class="role-word" data-roles={JSON.stringify(roles)}>{roles[0]}</span><span class="caret" aria-hidden="true"></span>
        </p>

        <p class="reveal">
          I'm a QA Tester at Accenture with 2+ years in software testing, and a BCA graduate from Lovely Professional
          University.
        </p>
        <p class="reveal">
          Being a person with a disability has given me a different lens on resilience, and on software. If it doesn't
          work for everyone, it doesn't work. That's the bar I test against.
        </p>
        <p class="reveal">
          At work I break enterprise apps on purpose. After hours I build AI tools that do the testing for me, like
          AbhiMate, and apps like DISCOVA that make places accessible.
        </p>

        <blockquote class="pull reveal">I test for the people most products <span class="grad-text">forget.</span></blockquote>

        <ul class="traits reveal" aria-label="What I bring">
          <li class="chip">Eye for detail</li>
          <li class="chip">Quick learner</li>
          <li class="chip">AI-first builder</li>
          <li class="chip">Growth mindset</li>
        </ul>

        <div class="links reveal">
          <a href={site.resume} class="btn btn-ghost" download="Abhinav_Saxena_Resume.pdf"><Icon name="download" /> Download resume</a>
          <a href={site.linkedin} class="btn btn-ghost" target="_blank" rel="noopener"><Icon name="linkedin" /> LinkedIn</a>
        </div>
      </div>
    </div>

    <dl class="stats">
      {stats.map((s, i) => (
        <div class="stat reveal" style={`--i:${i}`}>
          <dt>{s.label}</dt>
          <dd><span data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</span></dd>
        </div>
      ))}
    </dl>

    <div class="journey">
      <h3 class="reveal">Journey</h3>
      <ol>
        {journey.map((j, i) => (
          <li class="job reveal" style={`--i:${i}`}>
            <span class="when mono">{j.when}</span>
            <div>
              <h4>{j.title}</h4>
              <span class="org">{j.org}</span>
              <ul>
                {j.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .top { display: flex; flex-wrap: wrap; gap: clamp(36px, 5vw, 72px); align-items: center; }
  .photo {
    flex: 1 1 300px;
    max-width: 460px;
    margin: 0;
    position: relative;
    border-radius: 24px;
    padding: 1px;
    background: linear-gradient(140deg, #8b5cf6, transparent 40%, transparent 60%, #ec4899);
  }
  .photo :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 23px;
  }
  .photo figcaption {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: 999px;
    background: rgba(14, 15, 18, 0.78);
    color: #ececea;
    font-size: 12.5px;
  }
  .text { flex: 999 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  .text h2 { font-size: clamp(40px, 5vw, 68px); letter-spacing: -0.04em; }
  .text > p:not(.role) { color: var(--text-2); font-size: 17.5px; line-height: 1.7; max-width: 640px; }

  .role {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.35em;
    font-size: clamp(21px, 2.2vw, 28px);
    font-weight: 600;
    letter-spacing: -0.02em;
    min-height: 1.3em;
  }
  .role-pre { color: var(--text-3); font-weight: 500; }
  .caret {
    align-self: center;
    width: 3px;
    height: 1.05em;
    margin-left: 2px;
    border-radius: 2px;
    background: var(--violet);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .pull {
    margin: 8px 0 0;
    padding-left: 18px;
    border-left: 3px solid var(--violet);
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.02em;
  }
  .traits { display: flex; flex-wrap: wrap; gap: 10px; }
  .links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1px;
    margin: clamp(56px, 7vw, 88px) 0 0;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .stat { display: flex; flex-direction: column-reverse; gap: 6px; padding: 28px; background: var(--surface); }
  .stat dt { font-family: var(--f-mono); font-size: 13px; color: var(--text-3); }
  .stat dd { margin: 0; font-size: clamp(40px, 4vw, 56px); font-weight: 700; letter-spacing: -0.04em; line-height: 1; }
  .stat dd span { font-variant-numeric: tabular-nums; }

  .journey { margin-top: clamp(56px, 7vw, 88px); }
  .journey h3 { font-size: 28px; margin-bottom: 24px; }
  .journey ol { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
  .job {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .when {
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    color: var(--violet);
    border: 1px solid color-mix(in srgb, var(--violet) 40%, transparent);
  }
  .job h4 { font-size: 22px; font-weight: 600; letter-spacing: -0.01em; }
  .org { display: block; margin-top: 4px; color: var(--text-3); font-size: 15px; }
  .job ul { margin-top: 14px; display: flex; flex-direction: column; gap: 8px; }
  .job ul li { position: relative; padding-left: 18px; color: var(--text-2); font-size: 15.5px; }
  .job ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--grad);
  }
</style>

<script>
  // Role typewriter, only while the About block is on screen
  const roleEl = document.querySelector<HTMLElement>('[data-roles]');
  if (roleEl && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const roles: string[] = JSON.parse(roleEl.dataset.roles ?? '[]');
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    let visible = false;
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; }).observe(roleEl);
    (async () => {
      let i = 0;
      while (true) {
        while (!visible || document.hidden) await sleep(300);
        await sleep(2200);
        const word = roles[i];
        for (let n = word.length; n >= 0; n--) { roleEl.textContent = word.slice(0, n); await sleep(26); }
        i = (i + 1) % roles.length;
        const next = roles[i];
        await sleep(180);
        for (let n = 1; n <= next.length; n++) { roleEl.textContent = next.slice(0, n); await sleep(55); }
      }
    })();
  }
</script>
