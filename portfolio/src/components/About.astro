---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import Icon from './Icon.astro';
import { stats, journey, site } from '../data/site';

const facts = [
  { k: 'Role', v: 'QA Tester at Accenture' },
  { k: 'Experience', v: '2+ years in software testing' },
  { k: 'Education', v: 'BCA, Lovely Professional University' },
  { k: 'Based in', v: 'Gurgaon, India' },
  { k: 'Focus', v: 'Test automation and AI agents' },
  { k: 'Daily tools', v: 'Selenium, Playwright, Python, Jira, SQL' },
];
---
<section id="about" class="section">
  <div class="container">
    <div class="grid">
      <figure class="photo reveal">
        <Image
          src={avatar}
          alt="Abhinav Saxena at his desk with code on the screens behind him"
          widths={[480, 720, 960]}
          sizes="(max-width: 900px) 92vw, 560px"
          loading="lazy"
        />
        <figcaption>
          <span class="loc mono"><span class="dot pulse"></span> Gurgaon, India</span>
          <span class="quote">"I test for the people most products forget."</span>
        </figcaption>
      </figure>

      <div class="text">
        <span class="eyebrow reveal">// about me</span>
        <h2 class="reveal">Hi, I'm <span class="grad-text">Abhinav.</span></h2>

        <p class="lead reveal">
          I'm a QA Tester at Accenture. By day I make sure enterprise apps work before they reach real people. By night I
          build AI agents that do that testing on their own.
        </p>
        <p class="reveal">
          Being a person with a disability gave me a different lens on software: if it doesn't work for everyone, it
          doesn't work. That's why accessibility shows up in everything I build, from AbhiMate's built-in checks to
          DISCOVA, an app that tells you if a place is accessible before you go.
        </p>

        <dl class="facts reveal">
          {facts.map((f) => (
            <div class="fact">
              <dt>{f.k}</dt>
              <dd>{f.v}</dd>
            </div>
          ))}
        </dl>

        <div class="links reveal">
          <a href={site.resume} class="btn btn-primary" download="Abhinav_Saxena_Resume.pdf"><Icon name="download" /> Download resume</a>
          <a href={site.linkedin} class="btn btn-ghost" target="_blank" rel="noopener"><Icon name="linkedin" /> LinkedIn</a>
        </div>
      </div>
    </div>

    <dl class="stats">
      {stats.map((s, i) => (
        <div class="stat reveal" style={`--i:${i}`}>
          <dt>{s.label}</dt>
          <dd><span data-count={s.value} data-suffix={s.suffix}>{s.value}{s.suffix}</span></dd>
        </div>
      ))}
    </dl>

    <div class="journey">
      <h3 class="reveal">Journey</h3>
      <ol>
        {journey.map((j, i) => (
          <li class="job reveal" style={`--i:${i}`}>
            <span class="when mono">{j.when}</span>
            <div>
              <h4>{j.title}</h4>
              <span class="org">{j.org}</span>
              <ul>
                {j.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; align-items: start; }
  @media (min-width: 900px) {
    .grid { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: clamp(40px, 5vw, 80px); }
  }

  .photo {
    max-width: 560px;
    margin: 0;
    position: relative;
    border-radius: 28px;
    padding: 1px;
    background: linear-gradient(150deg, #8b5cf6, rgba(139, 92, 246, 0.15) 40%, rgba(236, 72, 153, 0.15) 60%, #ec4899);
    box-shadow: 0 50px 100px -50px rgba(139, 92, 246, 0.6);
  }
  @media (min-width: 900px) { .photo { position: sticky; top: 110px; } }
  .photo :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 58% 40%;
    border-radius: 27px;
  }
  .photo figcaption {
    position: absolute;
    left: 1px;
    right: 1px;
    bottom: 1px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 70px 22px 22px;
    border-radius: 0 0 27px 27px;
    background: linear-gradient(transparent, rgba(10, 10, 14, 0.92) 55%);
    color: #ececea;
  }
  .loc { display: inline-flex; align-items: center; gap: 8px; font-size: 12.5px; color: #c9c9c5; }
  .quote { font-size: clamp(19px, 1.8vw, 23px); font-weight: 600; line-height: 1.3; letter-spacing: -0.01em; }

  .text { min-width: 0; display: flex; flex-direction: column; gap: 20px; padding-top: 8px; }
  .text h2 { font-size: clamp(44px, 5.6vw, 76px); letter-spacing: -0.045em; }
  .text p { color: var(--text-2); font-size: 17.5px; line-height: 1.75; max-width: 640px; }
  .text p.lead { color: var(--text); font-size: clamp(19px, 1.7vw, 22px); line-height: 1.6; font-weight: 500; }

  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 8px 0 0;
    max-width: 680px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
  }
  .fact { display: flex; flex-direction: column; gap: 4px; padding: 16px 18px; background: var(--surface); }
  .fact dt { font-family: var(--f-mono); font-size: 12px; color: var(--violet); }
  .fact dd { margin: 0; font-size: 15.5px; font-weight: 500; color: var(--text); }
  @media (max-width: 560px) { .facts { grid-template-columns: minmax(0, 1fr); } }

  .links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }

  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1px;
    margin: clamp(56px, 7vw, 96px) 0 0;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .stat { display: flex; flex-direction: column-reverse; gap: 6px; padding: 28px; background: var(--surface); }
  .stat dt { font-family: var(--f-mono); font-size: 13px; color: var(--text-3); }
  .stat dd {
    margin: 0;
    font-size: clamp(40px, 4vw, 56px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    background: var(--grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat dd span { font-variant-numeric: tabular-nums; }

  .journey { margin-top: clamp(56px, 7vw, 88px); }
  .journey h3 { font-size: 28px; margin-bottom: 24px; }
  .journey ol { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
  .job {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .when {
    align-self: flex-start;
    padding: 4px 10px;
    border-radius: 999px;
    font-size: 12px;
    color: var(--violet);
    border: 1px solid color-mix(in srgb, var(--violet) 40%, transparent);
  }
  .job h4 { font-size: 22px; font-weight: 600; letter-spacing: -0.01em; }
  .org { display: block; margin-top: 4px; color: var(--text-3); font-size: 15px; }
  .job ul { margin-top: 14px; display: flex; flex-direction: column; gap: 8px; }
  .job ul li { position: relative; padding-left: 18px; color: var(--text-2); font-size: 15.5px; }
  .job ul li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.65em;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--grad);
  }
</style>
