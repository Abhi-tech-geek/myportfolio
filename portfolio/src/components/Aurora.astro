---
// WebGL aurora behind the hero. Built to stay light:
//  - rendered at ~40% resolution and scaled up by CSS (an aurora is soft anyway)
//  - capped at 30 fps, paused when off-screen or the tab is hidden
//  - skipped entirely for reduced motion, Save-Data, or no WebGL (CSS glow remains)
---
<div class="aurora" aria-hidden="true">
  <div class="fallback"></div>
  <canvas data-aurora></canvas>
</div>

<style>
  .aurora { position: absolute; inset: 0; pointer-events: none; }
  .fallback {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 70%;
    height: 110%;
    background: radial-gradient(closest-side, var(--glow), var(--glow-2) 55%, transparent);
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  canvas.on { opacity: 1; }
  :global(:root[data-theme='light']) canvas.on { opacity: 0.55; }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-aurora]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const saveData = (navigator as any).connection?.saveData === true;

  const init = () => {
    if (!canvas || reduce || saveData) return;
    const gl = canvas.getContext('webgl', { alpha: true, antialias: false, premultipliedAlpha: true, powerPreference: 'low-power' });
    if (!gl) return;
    // Software rasterizers would turn a soft background into a CPU hog: keep the CSS glow instead.
    const dbg = gl.getExtension('WEBGL_debug_renderer_info');
    const renderer = String(dbg ? gl.getParameter(dbg.UNMASKED_RENDERER_WEBGL) : gl.getParameter(gl.RENDERER));
    if (/swiftshader|llvmpipe|software|basic render/i.test(renderer)) return;
    {
    const vs = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
    const fs = `
      precision mediump float;
      uniform vec2 r; uniform float t; uniform vec2 m;
      float h(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7)))*43758.5453);}
      float n(vec2 p){vec2 i=floor(p),f=fract(p);vec2 u=f*f*(3.-2.*f);
        return mix(mix(h(i),h(i+vec2(1,0)),u.x),mix(h(i+vec2(0,1)),h(i+vec2(1,1)),u.x),u.y);}
      float fbm(vec2 p){float v=0.,a=.5;for(int i=0;i<5;i++){v+=a*n(p);p=p*2.03+vec2(1.7,9.2);a*=.5;}return v;}
      void main(){
        vec2 uv=gl_FragCoord.xy/r;
        vec2 p=uv*vec2(r.x/r.y,1.)*1.7;
        float tt=t*.035;
        vec2 q=vec2(fbm(p+vec2(0.,tt)),fbm(p+vec2(5.2,1.3)-tt));
        vec2 w=vec2(fbm(p+2.2*q+vec2(1.7,9.2)+tt*1.4),fbm(p+2.2*q+vec2(8.3,2.8)-tt));
        float f=fbm(p+2.6*w);
        vec3 violet=vec3(.545,.361,.965), blue=vec3(.231,.510,.965), pink=vec3(.925,.282,.6);
        vec3 col=mix(violet,blue,clamp(q.x*1.5-.2,0.,1.));
        col=mix(col,pink,clamp(w.y*w.y*1.8-.15,0.,1.));
        float glow=exp(-dot(uv-m,uv-m)*9.)*.45;
        float a=smoothstep(.42,1.,f)*.62+glow*f*.8;
        a*=smoothstep(.05,.75,uv.x*.9+uv.y*.35);   /* keep the copy side calm */
        gl_FragColor=vec4(col*a,a);
      }`;
    const compile = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, compile(gl.VERTEX_SHADER, vs));
    gl.attachShader(prog, compile(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(prog);

    if (gl.getProgramParameter(prog, gl.LINK_STATUS)) {
      gl.useProgram(prog);
      const buf = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, buf);
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      const loc = gl.getAttribLocation(prog, 'p');
      gl.enableVertexAttribArray(loc);
      gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
      const uR = gl.getUniformLocation(prog, 'r');
      const uT = gl.getUniformLocation(prog, 't');
      const uM = gl.getUniformLocation(prog, 'm');

      const SCALE = 0.4;
      const resize = () => {
        const w = Math.max(1, Math.round(canvas.clientWidth * SCALE));
        const hgt = Math.max(1, Math.round(canvas.clientHeight * SCALE));
        if (canvas.width !== w || canvas.height !== hgt) {
          canvas.width = w;
          canvas.height = hgt;
          gl.viewport(0, 0, w, hgt);
        }
        gl.uniform2f(uR, canvas.width, canvas.height);
      };
      resize();
      addEventListener('resize', resize);

      // Mouse light (eased), only tracked while the pointer is over the hero
      const hero = canvas.closest('section') ?? document.body;
      const target = { x: 0.75, y: 0.6 };
      const cur = { x: 0.75, y: 0.6 };
      hero.addEventListener('pointermove', (e) => {
        const b = canvas.getBoundingClientRect();
        target.x = (e.clientX - b.left) / b.width;
        target.y = 1 - (e.clientY - b.top) / b.height;
      });

      // One rAF loop at most; it stops itself when off-screen / hidden and is re-armed by schedule().
      let visible = true;
      let dead = false;
      let rafId = 0;
      let last = 0;
      const gaps: number[] = [];
      const start = performance.now();
      const schedule = () => { if (!dead && !rafId && visible && !document.hidden) rafId = requestAnimationFrame(loop); };
      // Coming back from hidden/off-screen: forget the old timestamp so the pause isn't counted as a slow frame
      const resume = () => { last = 0; schedule(); };
      function loop(now: number) {
        rafId = 0;
        if (!visible || document.hidden) return;
        schedule();
        if (now - last < 33) return; // ~30 fps cap
        // Auto kill-switch: if this device can't hold ~20 fps here, fade back to the CSS glow.
        // `last` is reset to 0 whenever the loop resumes (tab shown / hero back on screen),
        // so only genuinely slow frames are counted, however slow they are.
        const gap = now - last;
        if (last && gaps.length < 60) {
          gaps.push(gap);
          if (gaps.length === 60) {
            const avg = gaps.slice(10).reduce((a, b) => a + b, 0) / 50;
            if (avg > 50) {
              dead = true;
              canvas!.classList.remove('on');
              gl!.getExtension('WEBGL_lose_context')?.loseContext();
              return;
            }
          }
        }
        last = now;
        cur.x += (target.x - cur.x) * 0.06;
        cur.y += (target.y - cur.y) * 0.06;
        gl!.uniform1f(uT, (now - start) / 1000);
        gl!.uniform2f(uM, cur.x, cur.y);
        gl!.drawArrays(gl!.TRIANGLES, 0, 3);
      }
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; resume(); }).observe(canvas);
      document.addEventListener('visibilitychange', resume);
      schedule();
      canvas.classList.add('on');
    }
    }
  };

  // Start after the page has painted and the main thread is idle — never competes with first load.
  const later = () =>
    'requestIdleCallback' in window ? requestIdleCallback(init, { timeout: 1500 }) : setTimeout(init, 400);
  if (document.readyState === 'complete') later();
  else addEventListener('load', later, { once: true });
</script>
